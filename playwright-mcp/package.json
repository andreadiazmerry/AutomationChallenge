{
  "name": "playwright-mcp",
  "version": "1.0.0",
  "description": "Playwright + MCP automation project (saucedemo)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test --grep @login",
    "test:products": "playwright test --grep @products",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "mcp": "playwright-mcp --config playwright-mcp.config.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
